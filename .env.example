# Launch gate. Leave unset (or "false") until the team approves launch.
# When not exactly "true", robots.txt disallows everything and every page
# carries <meta name="robots" content="noindex, nofollow">.
NEXT_PUBLIC_SITE_LAUNCHED=false

# Optional: Google Search Console verification token. Only emitted when set.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
